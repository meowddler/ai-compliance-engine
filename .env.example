# Copy to .env and fill in. SECRET_KEY and DATABASE_URL are required —
# the application refuses to start without them.

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=postgresql+psycopg2://postgres:PASSWORD@localhost:5432/compliance

# Comma-separated. Empty means no cross-origin requests are permitted.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Evidence older than this is treated as unverifiable, not compliant.
EVIDENCE_FRESHNESS_DAYS=90

# AI layer. Omit NVIDIA_API_KEY to run without live inference.
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Optional: override default seeded passwords
ADMIN_PASSWORD=
AUDITOR_PASSWORD=
ANALYST_PASSWORD=




ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KEY_ID=